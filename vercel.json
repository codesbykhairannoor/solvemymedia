      "source": "/:tool(mov-to-mp4|mkv-to-mp4|webm-to-mp4|avi-to-mp4)",
      "destination": "/convert-video",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(remove-audio-from-video|mute-mp4)",
