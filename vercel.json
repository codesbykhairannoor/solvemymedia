      "destination": "/:lang/create-gif",
      "permanent": true
    },
    {
      "source": "/:tool(mp4-to-gif|mov-to-gif)",
      "destination": "/create-gif",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(join-audio-files|merge-mp3)",
      "destination": "/:lang/merge-audio",
      "permanent": true
    },
    {
      "source": "/:tool(join-audio-files|merge-mp3)",
      "destination": "/merge-audio",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(add-watermark-to-mp4)",
      "destination": "/:lang/watermark-video",
      "permanent": true
    },
    {
      "source": "/:tool(add-watermark-to-mp4)",
      "destination": "/watermark-video",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(screen-recorder|audio-recorder)",
      "destination": "/:lang/recorder",
      "permanent": true
    },
    {
      "source": "/:tool(screen-recorder|audio-recorder)",
      "destination": "/recorder",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"llms-txt\""
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/:file(favicon\\.svg|logoweb\\.png|robots\\.txt|llms\\.txt|llms-full\\.txt|sitemap\\.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:file(sw\\.js|workbox-.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
