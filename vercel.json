{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.solvemymedia.com"
        }
      ],
      "destination": "https://solvemymedia.com/:path*",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(transcribe-mp3|transcribe-mp4)",
      "destination": "/:lang/transcribe",
      "permanent": true
    },
    {
      "source": "/:tool(transcribe-mp3|transcribe-mp4)",
      "destination": "/transcribe",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(compress-mov|compress-mp4|compress-webm)",
      "destination": "/:lang/compress-video",
      "permanent": true
    },
    {
      "source": "/:tool(compress-mov|compress-mp4|compress-webm)",
      "destination": "/compress-video",
      "permanent": true
    },
    {
      "source": "/:lang(en|id|es|fr|de|it|pt|nl|pl|ru|ja|ko|zh|zh-TW|tr|vi|th|ar|hi|sv|no|da|fi|cs|hu|el|ro|uk|ms|tl|he|sk)/:tool(compress-mp3|compress-wav)",
